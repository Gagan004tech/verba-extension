{
  "manifest_version": 3,
  "name": "VERBA - Voice Assistant",
  "version": "1.0.0",
  "description": "Voice-driven form-filling assistant",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_title": "Open VERBA Assistant"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
    "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
  {
    "resources": ["src/sidepanel/permission.html", "src/sidepanel/permission.js"],
    "matches": ["<all_urls>"]
  }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "linux": "Ctrl+Shift+V"
      },
      "description": "Open VERBA side panel"
    }
  }
}
